{
  // Dev container definition. Reference: https://containers.dev/implementors/json_reference/
  "name": "Argo CD (builder)",

  // Use Ubuntu 22 since most jobs in .github/workflows/ci-build.yaml run on ubuntu-22.04
  // The dev environment should ideally match the CI pipeline as closely as feasible
  // to minimize the "works on my machine" problem.
  "image": "mcr.microsoft.com/vscode/devcontainers/base:ubuntu-22.04",

  "forwardPorts": [
    // API server
    8080,
    // UI
    4000,
    // Helm registry
    5000
  ],

  "hostRequirements": {
    // This is mainly here for CodeSpaces, since otherwise it'll default to 2 CPUs, which is unusably slow
    "cpus": 4
  },

  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      // Should ideally match GOLANG_VERSION in .github/workflows/ci-build.yaml
      "version": "1.25.3"
    },
    "ghcr.io/devcontainers/features/node:1": {
      // Should ideally match node-version in .github/workflows/ci-build.yaml
      "version": "22.9.0"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/rio/features/k3d:1": {},
    "ghcr.io/lentzi90/features/tilt:0": {}
  },

  "postCreateCommand": ".devcontainer/post-create.sh",

  "customizations": {
    "codespaces": {
      "openFiles": [
        "docs/developer-guide/running-locally.md"
      ]
    },
    "vscode": {
      "settings": {
        "launch": {
          "configurations": [
            {
              "name": "Attach to argocd server",
              "type": "go",
              "request": "attach",
              "mode": "local",
              "processId": "argo"
            }
          ]
        }
      }
    }
  }
}
